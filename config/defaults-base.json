{
  "server": {
    "serverAddress": "comfyui.example.local",
    "serverPort": 8188
  },
  "storage": {
    "serverMountPath": "\\\\HOSTNAME\\share",
    "localMountPath": {
      "macos": "/Volumes/comfyui-share",
      "windows": "\\\\HOSTNAME\\share",
      "linux": "/mnt/comfyui-share"
    }
  },
  "controls": {
    "enableProcessing": false,
    "enableCache": true,
    "timeout": 600,
    "asyncMode": 1,
    "placeholderMode": 1
  }
}
