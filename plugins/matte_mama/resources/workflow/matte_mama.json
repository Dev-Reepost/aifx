{
  "44": {
    "inputs": {
      "filepath": "${INPUT_PATH}",
      "tonemap": "linear",
      "image_load_cap": "${IMAGE_LOAD_CAP}",
      "skip_first_images": 0,
      "select_every_nth": 1
    },
    "class_type": "LoadEXR",
    "_meta": { "title": "Load EXR" }
  },
  "55": {
    "inputs": {
      "model_path": "${SAM3_MODEL_PATH}"
    },
    "class_type": "LoadSAM3Model",
    "_meta": { "title": "(down)Load SAM3 Model" }
  },
  "52": {
    "inputs": {
      "prompt_mode": "text",
      "text_prompt": "${TEXT_PROMPT}",
      "frame_idx": "${FRAME_IDX}",
      "score_threshold": "${SCORE_THRESHOLD}",
      "video_frames": ["44", 0]
    },
    "class_type": "SAM3VideoSegmentation",
    "_meta": { "title": "SAM3 Video Segmentation" }
  },
  "53": {
    "inputs": {
      "start_frame": 0,
      "end_frame": -1,
      "direction": "${DIRECTION}",
      "offload_model": "${OFFLOAD_SAM3_MODEL}",
      "sam3_model": ["55", 0],
      "video_state": ["52", 0]
    },
    "class_type": "SAM3Propagate",
    "_meta": { "title": "SAM3 Propagate" }
  },
  "54": {
    "inputs": {
      "obj_id": "${OBJ_ID}",
      "plot_all_masks": "${PLOT_ALL_MASKS}",
