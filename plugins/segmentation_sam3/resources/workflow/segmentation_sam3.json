{
  "2": {
    "inputs": {
      "ckpt_name": "${CKPT_NAME}"
    },
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "Load Checkpoint"
    }
  },
  "8": {
    "inputs": {
      "detection_threshold": "${SCORE_THRESHOLD}",
      "max_objects": "${MAX_OBJECTS}",
      "detect_interval": "${DETECT_INTERVAL}",
      "images": ["24", 0],
      "model": ["2", 0],
      "initial_mask": ["13", 0],
      "conditioning": ["14", 0]
    },
    "class_type": "SAM3_VideoTrack",
    "_meta": {
      "title": "SAM3 Video Track"
    }
  },
  "9": {
    "inputs": {
      "object_indices": "${OBJECT_INDICES}",
      "track_data": ["8", 0]
    },
    "class_type": "SAM3_TrackToMask",
    "_meta": {
      "title": "SAM3 Track to Mask"
    }
  },
  "13": {
    "inputs": {
      "threshold": "${SCORE_THRESHOLD}",
      "refine_iterations": "${REFINE_ITERATIONS}",
      "individual_masks": "${INDIVIDUAL_MASKS}",
      "model": ["2", 0],
      "image": ["15", 0],
      "conditioning": ["14", 0]
    },
    "class_type": "SAM3_Detect",
    "_meta": {
      "title": "SAM3 Detect"
    }
  },
  "14": {
    "inputs": {
      "text": "${PROMPT}",
      "clip": ["2", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "CLIP Text Encode (Prompt)"
    }
  },
  "15": {
    "inputs": {
      "batch_index": "${BATCH_INDEX}",
      "length": 1,
      "image": ["24", 0]
    },
    "class_type": "ImageFromBatch",
    "_meta": {
      "title": "ImageFromBatch"
    }
  },
  "16": {
    "inputs": {
      "mask": ["9", 0]
    },
    "class_type": "MaskToImage",
    "_meta": {
      "title": "Convert Mask to Image"
    }
  },
  "23": {
    "inputs": {
      "filename_prefix": "${OUTPUT_PREFIX}",
      "tonemap": "linear",
      "version": -1,
      "start_frame": "${FRAME}",
      "frame_pad": 4,
      "save_workflow": "none",
      "create_path_if_missing": true,
      "images": ["16", 0]
    },
    "class_type": "SaveEXR",
    "_meta": {
      "title": "Save EXR"
    }
  },
  "24": {
    "inputs": {
      "filepath": "${INPUT_PATH}",
      "tonemap": "linear",
      "image_load_cap": "${IMAGE_LOAD_CAP}",
      "skip_first_images": 0,
      "select_every_nth": 1
    },
    "class_type": "LoadEXR",
    "_meta": {
      "title": "Load EXR"
    }
  }
}
