# CMake / Conan build outputs ------------------------------------------------
build/
dist/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
install_manifest.txt
Testing/
compile_commands.json

# Conan local cache (should never be checked in) -----------------------------
.conan/
.conan2/
conan_provider.cmake

# FetchContent / external sources (when written outside build/) --------------
_deps/

# macOS installer SPM build + staged bundle payloads -------------------------
# (installer/macos/Resources/Bundles/ is repopulated from
#  dist/aifx-<ver>-macos-universal.tar.gz by tools/release-macos-installer.sh)
installer/macos/.build/
installer/macos/build/
installer/macos/Resources/Bundles/

# Jekyll / GitHub Pages build artifacts --------------------------------------
_site/
.jekyll-cache/
.jekyll-metadata
.bundle/
vendor/
Gemfile.lock

# Local working notes — gitignored on purpose, see NOTES.md at repo root.
NOTES.md

# OS / editor cruft ----------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE state — intentionally not ignored at repo level; let contributors
# manage their own .vscode/.idea via global gitignore.
